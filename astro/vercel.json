{
  "redirects": [
    {
      "source": "/qr/h",
      "destination": "https://os.campfire.hk",
      "permanent": false
    },
    {
      "source": "/hunt/:path*",
      "destination": "https://os.campfire.hk/hunt/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/ph/static/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/ph/:path(.*)",
      "destination": "https://us.i.posthog.com/:path"
    }
  ]
}
