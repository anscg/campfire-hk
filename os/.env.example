# ── Convex (self-hosted) ──────────────────────────────────────────────────────
CONVEX_SELF_HOSTED_URL=https://your-convex-backend.example.com
NEXT_PUBLIC_CONVEX_URL=https://your-convex-backend.example.com
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-convex-backend.example.com
CONVEX_SELF_HOSTED_ADMIN_KEY=self-hosted-convex|your-admin-key-here

# ── Backend Express server ────────────────────────────────────────────────────
SERVER_PORT=3001
JWT_SECRET=change-me-to-a-long-random-secret
# With the Next.js rewrite proxy, the browser always calls /api/* on the same
# domain — so CORS only needs to allow the app's own origin.
CORS_ORIGIN=https://your-app-domain.example.com

# Internal URL Next.js uses to forward /api/* rewrites to Express (container-local)
INTERNAL_API_URL=http://localhost:3001

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_SECRET=change-me-to-a-long-random-secret

# ── Resend email ──────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Campfire OS <os@yourdomain.com>

# ── Frontend (baked into the Next.js bundle at build time) ───────────────────
# In production (Docker): leave empty — Next.js rewrites /api/* to Express internally,
# so the browser calls the same domain with no host prefix needed.
# In local dev: set to http://localhost:3001 so the browser can reach the Express server directly.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key_here

# ── CampPay QR deep-link base URL ─────────────────────────────────────────────
NEXT_PUBLIC_CLIENT_URL=https://your-app-domain.example.com
