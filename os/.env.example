# ── Convex (self-hosted) ──────────────────────────────────────────────────────
CONVEX_SELF_HOSTED_URL=https://your-convex-backend.example.com
NEXT_PUBLIC_CONVEX_URL=https://your-convex-backend.example.com
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-convex-backend.example.com
CONVEX_SELF_HOSTED_ADMIN_KEY=self-hosted-convex|your-admin-key-here

# ── Backend Express server ────────────────────────────────────────────────────
SERVER_PORT=3001
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGIN=http://localhost:3000

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_SECRET=change-me-to-a-long-random-secret

# ── Resend email ──────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Campfire OS <os@yourdomain.com>

# ── Frontend (baked into the Next.js bundle at build time) ───────────────────
# These must also be passed as Docker build ARGs (handled by docker-compose.yml)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key_here

# ── CampPay QR deep-link base URL ─────────────────────────────────────────────
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000
